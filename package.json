{
	"name": "dsh-visual",
	"version": "0.1.0",
	"description": "Interactive visual cards inline in the dsh conversation: the model publishes self-contained HTML (rendered in a Shadow DOM with its own scripts) or a draggable flowchart, and the tool blocks until the user submits — comments, fields, flow and card state all come back as the tool result.",
	"keywords": [
		"dsh",
		"dsh-plugin",
		"deepseek-harness",
		"generative-ui",
		"artifact",
		"cordis"
	],
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": {
			"default": "./lib/index.js"
		},
		"./client": {
			"default": "./lib/client.js"
		},
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"files": [
		"lib/index.js",
		"lib/client.js",
		"cordis.patch.yml",
		"README.md",
		"LICENSE",
		"examples",
		"CHANGELOG.md"
	],
	"license": "MIT",
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"inject": [],
			"platform": "web"
		}
	},
	"peerDependencies": {
		"@deepseek-ai/dsh-tools": "*",
		"@deepseek-ai/dsh-typert-protocol": "*",
		"react": "^18.2.0"
	},
	"scripts": {
		"check": "node --check lib/index.js && node --check lib/client.js && node scripts/docs-check.mjs",
		"prepublishOnly": "npm run check"
	},
	"engines": {
		"node": ">=20"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MjxUpUp/dsh-visual.git"
	},
	"homepage": "https://github.com/MjxUpUp/dsh-visual#readme",
	"bugs": {
		"url": "https://github.com/MjxUpUp/dsh-visual/issues"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"peerDependenciesMeta": {
		"@deepseek-ai/dsh-tools": {
			"optional": true
		},
		"@deepseek-ai/dsh-typert-protocol": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"author": "MjxUpUp <44393475+MjxUpUp@users.noreply.github.com>"
}
